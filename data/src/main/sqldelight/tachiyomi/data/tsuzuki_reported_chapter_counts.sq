CREATE TABLE tsuzuki_reported_chapter_counts(
    canonical_title_id TEXT NOT NULL,
    provider TEXT NOT NULL,
    chapter_count INTEGER,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY(canonical_title_id, provider),
    FOREIGN KEY(canonical_title_id) REFERENCES tsuzuki_titles(id) ON DELETE CASCADE
);

getTsuzukiReportedChapterCountsByTitle:
SELECT *
FROM tsuzuki_reported_chapter_counts
WHERE canonical_title_id = :canonicalTitleId
ORDER BY provider ASC;

upsertTsuzukiReportedChapterCount:
INSERT INTO tsuzuki_reported_chapter_counts(
    canonical_title_id,
    provider,
    chapter_count,
    updated_at
)
VALUES (
    :canonicalTitleId,
    :provider,
    :chapterCount,
    :updatedAt
)
ON CONFLICT(canonical_title_id, provider) DO UPDATE SET
    chapter_count = excluded.chapter_count,
    updated_at = excluded.updated_at;
