CREATE TABLE tsuzuki_catalog_cache(
    provider_id TEXT NOT NULL,
    query_key TEXT NOT NULL,
    sort TEXT NOT NULL,
    raw_offset INTEGER NOT NULL,
    page_size INTEGER NOT NULL,
    payload_json TEXT NOT NULL,
    fetched_at INTEGER NOT NULL,
    expires_at INTEGER NOT NULL,
    stale_until INTEGER NOT NULL,
    PRIMARY KEY(provider_id, query_key, sort, raw_offset, page_size)
);

CREATE INDEX tsuzuki_catalog_cache_stale_index
ON tsuzuki_catalog_cache(stale_until);

getTsuzukiCatalogCache:
SELECT *
FROM tsuzuki_catalog_cache
WHERE provider_id = :providerId
AND query_key = :queryKey
AND sort = :sort
AND raw_offset = :rawOffset
AND page_size = :pageSize
LIMIT 1;

upsertTsuzukiCatalogCache:
INSERT INTO tsuzuki_catalog_cache(
    provider_id,
    query_key,
    sort,
    raw_offset,
    page_size,
    payload_json,
    fetched_at,
    expires_at,
    stale_until
)
VALUES (
    :providerId,
    :queryKey,
    :sort,
    :rawOffset,
    :pageSize,
    :payloadJson,
    :fetchedAt,
    :expiresAt,
    :staleUntil
)
ON CONFLICT(provider_id, query_key, sort, raw_offset, page_size) DO UPDATE SET
    payload_json = excluded.payload_json,
    fetched_at = excluded.fetched_at,
    expires_at = excluded.expires_at,
    stale_until = excluded.stale_until;

deleteTsuzukiCatalogCache:
DELETE FROM tsuzuki_catalog_cache
WHERE provider_id = :providerId
AND query_key = :queryKey
AND sort = :sort
AND raw_offset = :rawOffset
AND page_size = :pageSize;

pruneTsuzukiCatalogCache:
DELETE FROM tsuzuki_catalog_cache
WHERE stale_until < :now;
