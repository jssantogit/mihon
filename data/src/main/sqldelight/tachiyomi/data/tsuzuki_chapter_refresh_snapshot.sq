CREATE TABLE tsuzuki_chapter_refresh_snapshot(
    canonical_title_id TEXT NOT NULL,
    scope_key TEXT NOT NULL,
    fingerprint TEXT,
    configuration_fingerprint TEXT NOT NULL,
    observed_at INTEGER NOT NULL,
    refreshed_at INTEGER NOT NULL,
    item_count INTEGER NOT NULL,
    PRIMARY KEY(canonical_title_id, scope_key),
    FOREIGN KEY(canonical_title_id) REFERENCES tsuzuki_titles(id) ON DELETE CASCADE
);

CREATE INDEX tsuzuki_chapter_refresh_snapshot_title_index
ON tsuzuki_chapter_refresh_snapshot(canonical_title_id);

getTsuzukiChapterRefreshSnapshot:
SELECT *
FROM tsuzuki_chapter_refresh_snapshot
WHERE canonical_title_id = :canonicalTitleId
AND scope_key = :scopeKey
LIMIT 1;

upsertTsuzukiChapterRefreshSnapshot:
INSERT INTO tsuzuki_chapter_refresh_snapshot(
    canonical_title_id,
    scope_key,
    fingerprint,
    configuration_fingerprint,
    observed_at,
    refreshed_at,
    item_count
)
VALUES (
    :canonicalTitleId,
    :scopeKey,
    :fingerprint,
    :configurationFingerprint,
    :observedAt,
    :refreshedAt,
    :itemCount
)
ON CONFLICT(canonical_title_id, scope_key) DO UPDATE SET
    fingerprint = excluded.fingerprint,
    configuration_fingerprint = excluded.configuration_fingerprint,
    observed_at = excluded.observed_at,
    refreshed_at = excluded.refreshed_at,
    item_count = excluded.item_count;

deleteTsuzukiChapterRefreshSnapshotsByTitle:
DELETE FROM tsuzuki_chapter_refresh_snapshot
WHERE canonical_title_id = :canonicalTitleId;
