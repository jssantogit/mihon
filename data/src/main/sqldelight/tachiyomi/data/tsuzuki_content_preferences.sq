CREATE TABLE tsuzuki_content_preferences(
    canonical_title_id TEXT NOT NULL PRIMARY KEY,
    preferred_addon_id TEXT,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY(canonical_title_id) REFERENCES tsuzuki_titles(id) ON DELETE CASCADE
);

getTsuzukiContentPreference:
SELECT *
FROM tsuzuki_content_preferences
WHERE canonical_title_id = :canonicalTitleId
LIMIT 1;

getAllTsuzukiContentPreferences:
SELECT *
FROM tsuzuki_content_preferences
ORDER BY canonical_title_id ASC;

upsertTsuzukiContentPreference:
INSERT INTO tsuzuki_content_preferences(
    canonical_title_id,
    preferred_addon_id,
    updated_at
)
VALUES (
    :canonicalTitleId,
    :preferredAddonId,
    :updatedAt
)
ON CONFLICT(canonical_title_id) DO UPDATE SET
    preferred_addon_id = excluded.preferred_addon_id,
    updated_at = excluded.updated_at;

deleteTsuzukiContentPreference:
DELETE FROM tsuzuki_content_preferences
WHERE canonical_title_id = :canonicalTitleId;
