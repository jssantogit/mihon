import kotlin.Boolean;

CREATE TABLE tsuzuki_reader_preferences(
    canonical_title_id TEXT NOT NULL PRIMARY KEY,
    automatic_fallback INTEGER AS Boolean NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY(canonical_title_id) REFERENCES tsuzuki_titles(id) ON DELETE CASCADE
);

getTsuzukiReaderPreference:
SELECT *
FROM tsuzuki_reader_preferences
WHERE canonical_title_id = :canonicalTitleId
LIMIT 1;

observeTsuzukiReaderPreference:
SELECT *
FROM tsuzuki_reader_preferences
WHERE canonical_title_id = :canonicalTitleId
LIMIT 1;

upsertTsuzukiReaderPreference:
INSERT INTO tsuzuki_reader_preferences(
    canonical_title_id,
    automatic_fallback,
    updated_at
)
VALUES (
    :canonicalTitleId,
    :automaticFallback,
    :updatedAt
)
ON CONFLICT(canonical_title_id) DO UPDATE SET
    automatic_fallback = excluded.automatic_fallback,
    updated_at = excluded.updated_at;
