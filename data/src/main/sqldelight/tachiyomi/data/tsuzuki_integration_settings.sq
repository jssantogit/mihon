import kotlin.Boolean;

CREATE TABLE tsuzuki_integration_settings(
    integration_id TEXT NOT NULL PRIMARY KEY,
    enabled INTEGER AS Boolean NOT NULL,
    config_json TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

getTsuzukiIntegrationSetting:
SELECT *
FROM tsuzuki_integration_settings
WHERE integration_id = :integrationId
LIMIT 1;

getAllTsuzukiIntegrationSettings:
SELECT *
FROM tsuzuki_integration_settings
ORDER BY integration_id ASC;

upsertTsuzukiIntegrationSetting:
INSERT INTO tsuzuki_integration_settings(
    integration_id,
    enabled,
    config_json,
    updated_at
)
VALUES (
    :integrationId,
    :enabled,
    :configJson,
    :updatedAt
)
ON CONFLICT(integration_id) DO UPDATE SET
    enabled = excluded.enabled,
    config_json = excluded.config_json,
    updated_at = excluded.updated_at;

deleteTsuzukiIntegrationSetting:
DELETE FROM tsuzuki_integration_settings
WHERE integration_id = :integrationId;
