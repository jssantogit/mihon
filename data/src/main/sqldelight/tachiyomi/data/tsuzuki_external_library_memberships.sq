CREATE TABLE tsuzuki_external_library_memberships(
    canonical_title_id TEXT NOT NULL,
    provider TEXT NOT NULL,
    external_id TEXT NOT NULL,
    list_key TEXT NOT NULL,
    status TEXT,
    remote_status TEXT,
    progress REAL,
    score REAL,
    synced_at INTEGER NOT NULL,
    PRIMARY KEY(provider, external_id, list_key),
    FOREIGN KEY(canonical_title_id) REFERENCES tsuzuki_titles(id) ON DELETE CASCADE
);

CREATE INDEX tsuzuki_external_library_title_index
ON tsuzuki_external_library_memberships(canonical_title_id);

CREATE INDEX tsuzuki_external_library_provider_index
ON tsuzuki_external_library_memberships(provider);

getAllTsuzukiExternalLibraryMemberships:
SELECT *
FROM tsuzuki_external_library_memberships
ORDER BY provider ASC, list_key ASC, external_id ASC;

getTsuzukiExternalLibraryProviderIds:
SELECT DISTINCT provider
FROM tsuzuki_external_library_memberships
ORDER BY provider ASC;

upsertTsuzukiExternalLibraryMembership:
INSERT INTO tsuzuki_external_library_memberships(
    canonical_title_id,
    provider,
    external_id,
    list_key,
    status,
    remote_status,
    progress,
    score,
    synced_at
)
VALUES (
    :canonicalTitleId,
    :provider,
    :externalId,
    :listKey,
    :status,
    :remoteStatus,
    :progress,
    :score,
    :syncedAt
)
ON CONFLICT(provider, external_id, list_key) DO UPDATE SET
    canonical_title_id = excluded.canonical_title_id,
    status = excluded.status,
    remote_status = excluded.remote_status,
    progress = excluded.progress,
    score = excluded.score,
    synced_at = excluded.synced_at;

deleteTsuzukiExternalLibraryMembershipsByProvider:
DELETE FROM tsuzuki_external_library_memberships
WHERE provider = :provider;
