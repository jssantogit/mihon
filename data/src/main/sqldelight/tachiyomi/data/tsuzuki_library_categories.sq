CREATE TABLE tsuzuki_library_categories(
    canonical_title_id TEXT NOT NULL,
    category_id INTEGER NOT NULL,
    PRIMARY KEY(canonical_title_id, category_id),
    FOREIGN KEY(canonical_title_id) REFERENCES tsuzuki_titles(id) ON DELETE CASCADE,
    FOREIGN KEY(category_id) REFERENCES categories(_id) ON DELETE CASCADE
);

CREATE INDEX tsuzuki_library_categories_category_index
ON tsuzuki_library_categories(category_id);

getAllTsuzukiLibraryCategories:
SELECT
    lc.canonical_title_id,
    c._id AS category_id,
    c.name,
    c.sort AS category_order,
    c.flags
FROM tsuzuki_library_categories lc
JOIN categories c ON c._id = lc.category_id
ORDER BY c.sort ASC, c._id ASC, lc.canonical_title_id ASC;

getTsuzukiLibraryCategoriesByTitle:
SELECT
    c._id AS category_id,
    c.name,
    c.sort AS category_order,
    c.flags
FROM tsuzuki_library_categories lc
JOIN categories c ON c._id = lc.category_id
WHERE lc.canonical_title_id = :canonicalTitleId
ORDER BY c.sort ASC, c._id ASC;

deleteTsuzukiLibraryCategoriesByTitle:
DELETE FROM tsuzuki_library_categories
WHERE canonical_title_id = :canonicalTitleId;

insertTsuzukiLibraryCategory:
INSERT OR IGNORE INTO tsuzuki_library_categories(
    canonical_title_id,
    category_id
)
VALUES (
    :canonicalTitleId,
    :categoryId
);
