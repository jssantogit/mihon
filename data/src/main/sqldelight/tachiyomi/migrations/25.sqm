DROP TRIGGER tsuzuki_collections_sync_dirty_delete;
DROP TRIGGER tsuzuki_folders_sync_dirty_insert;
DROP TRIGGER tsuzuki_folders_sync_dirty_update;
DROP TRIGGER tsuzuki_folders_sync_dirty_delete;
DROP TRIGGER tsuzuki_lists_sync_dirty_insert;
DROP TRIGGER tsuzuki_lists_sync_dirty_update;
DROP TRIGGER tsuzuki_lists_sync_dirty_delete;
DROP TRIGGER tsuzuki_titles_sync_dirty_insert;
DROP TRIGGER tsuzuki_titles_sync_dirty_update;
DROP TRIGGER tsuzuki_titles_sync_dirty_delete;

CREATE TRIGGER tsuzuki_library_entries_sync_dirty_insert
AFTER INSERT ON tsuzuki_library_entries
BEGIN
    INSERT INTO tsuzuki_sync_outbox(document_kind, enqueued_at, attempt_count, next_attempt_at)
    SELECT 'LIBRARY', CAST(strftime('%s', 'now') AS INTEGER) * 1000, 0, NULL
    WHERE NOT EXISTS (
        SELECT 1
        FROM tsuzuki_sync_outbox
        WHERE document_kind = 'LIBRARY'
    );

    UPDATE tsuzuki_sync_outbox
    SET attempt_count = 0,
        next_attempt_at = NULL
    WHERE document_kind = 'LIBRARY';
END;

