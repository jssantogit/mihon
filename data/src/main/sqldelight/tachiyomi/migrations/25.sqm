-- Recreate dirty triggers without OR IGNORE so outer UPSERT conflict policies
-- cannot turn an enqueue into a constraint failure.

DROP TRIGGER tsuzuki_library_entries_sync_dirty_insert;
DROP TRIGGER tsuzuki_library_entries_sync_dirty_update;
DROP TRIGGER tsuzuki_library_entries_sync_dirty_delete;
DROP TRIGGER tsuzuki_source_mappings_sync_dirty_insert;
DROP TRIGGER tsuzuki_source_mappings_sync_dirty_update;
DROP TRIGGER tsuzuki_source_mappings_sync_dirty_delete;
DROP TRIGGER tsuzuki_source_preferences_sync_dirty_insert;
DROP TRIGGER tsuzuki_source_preferences_sync_dirty_update;
DROP TRIGGER tsuzuki_source_preferences_sync_dirty_delete;
