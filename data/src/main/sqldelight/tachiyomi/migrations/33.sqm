import kotlin.Boolean;

-- Durable, local-only Reader projection outbox. Progress events coalesce; history
-- carries additive duration until legacy application and acknowledgement commit
-- in the same SQLite transaction. Rows are retained only while work is pending.
CREATE TABLE tsuzuki_mihon_projection_queue(
    canonical_chapter_id TEXT NOT NULL,
    mihon_chapter_id INTEGER NOT NULL,
    has_pending_progress INTEGER AS Boolean NOT NULL DEFAULT 0,
    progress_read INTEGER AS Boolean,
    progress_page INTEGER,
    has_pending_history INTEGER AS Boolean NOT NULL DEFAULT 0,
    pending_duration INTEGER NOT NULL DEFAULT 0,
    history_read_at INTEGER,
    updated_at INTEGER NOT NULL,
    generation INTEGER NOT NULL DEFAULT 1,
    attempt_count INTEGER NOT NULL DEFAULT 0,
    next_retry_at INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY(canonical_chapter_id, mihon_chapter_id),
    FOREIGN KEY(canonical_chapter_id)
        REFERENCES tsuzuki_canonical_chapters(id) ON DELETE CASCADE
);

CREATE INDEX tsuzuki_mihon_projection_due_index
ON tsuzuki_mihon_projection_queue(next_retry_at, updated_at);

